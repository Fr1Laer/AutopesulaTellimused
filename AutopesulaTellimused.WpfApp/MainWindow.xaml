<Window x:Class="AutopesulaTellimused.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutopesulaTellimused.WpfApp"
        mc:Ignorable="d"
        Title="Autopesula Tellimused" Height="500" Width="750">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Reg-number:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold" FontSize="16"/>
            <TextBox x:Name="LicensePlateTextBox" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="16"/>

            <TextBlock Text="Sõiduk:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold" FontSize="16"/>
            <ComboBox x:Name="VehicleTypeComboBox" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="16"/>

            <TextBlock Text="Pesuprogramm:" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold" FontSize="16"/>
            <ComboBox x:Name="WashProgramComboBox" Grid.Column="5" VerticalAlignment="Center" FontSize="16"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button x:Name="AddButton" Content="Lisa tellimus" Click="AddButton_Click" Padding="12,5" Margin="0,0,10,0" FontWeight="Bold" FontSize="16"/>
            <Button x:Name="EditButton" Content="Muuda valitud" Click="EditButton_Click" Padding="12,5" Margin="0,0,10,0" FontSize="16"/>
            <Button x:Name="DeleteButton" Content="Kustuta valitud" Click="DeleteButton_Click" Padding="12,5" FontSize="16"/>
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Foreground="Red" Margin="0,0,0,10" FontWeight="SemiBold"/>
        <DataGrid x:Name="OrdersDataGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" 
                  SelectionChanged="OrdersDataGrid_SelectionChanged" Margin="0,0,0,10" FontSize="16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Reg-number" Binding="{Binding LicensePlate}" Width="*"/>
                <DataGridTextColumn Header="Sõiduki liik" Binding="{Binding VehicleType}" Width="*"/>
                <DataGridTextColumn Header="Pesuprogramm" Binding="{Binding WashProgram}" Width="*"/>
                <DataGridTextColumn Header="Kestus (min)" Binding="{Binding DurationMinutes}" Width="90"/>
                <DataGridTextColumn Header="Hind (€)" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TotalScoreTextBlock" Grid.Row="4" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Text="Kokku tellimusi: 0 | Kogusumma: 0.00 €"/>
    </Grid>
</Window>
